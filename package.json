{
  "name": "payload-ai-suite",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r lint",
    "dev:store": "pnpm --filter dev-store dev",
    "dev:services": "pnpm --filter dev-services dev",
    "evals": "pnpm --filter @payload-ai-suite/tooling evals"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
