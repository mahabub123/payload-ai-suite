# --- Core ---
DATABASE_URI=postgres://payload:payload@localhost:5433/payload_ai_store
PAYLOAD_SECRET=change-me-to-a-32+-character-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Email (Mailpit from docker-compose: UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=store@example.test

# --- AI providers (keys stay in env; config only references the variable names) ---
# AI_MOCK=1 runs every model call against the in-process mock provider (no network, no cost).
AI_MOCK=1
# Per-token delay for the mock stream (ms) — used by the k6 SSE load test.
AI_MOCK_DELAY_MS=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Local Ollama (OpenAI-compatible). Leave empty to disable.
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional model overrides (providerId:modelId lists, comma-separated, first = preferred)
# AI_ROUTE_CHAT=anthropic:claude-sonnet-5-5,openai:gpt-5-mini
# AI_ROUTE_EMBED=openai:text-embedding-3-small

# Monthly AI budget in micro-USD (100000000 = $100)
AI_MONTHLY_BUDGET_MICROS=100000000

# Cloudflare Turnstile (anonymous chat). Leave empty in dev.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Channels (optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=

# Jobs: run the Payload job queue inside the dev server (set 0 when a separate worker runs jobs)
JOBS_AUTORUN=1
