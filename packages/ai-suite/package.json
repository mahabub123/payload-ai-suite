{
  "name": "payload-ai-suite",
  "version": "0.2.0",
  "private": true,
  "description": "One-line installer composing the AI Suite plugins",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0",
    "payload-ai-core": "workspace:*",
    "payload-ai-adapters": "workspace:*",
    "payload-ai-content": "workspace:*",
    "payload-ai-search": "workspace:*",
    "payload-ai-assistant": "workspace:*",
    "payload-ai-marketing": "workspace:*",
    "payload-ai-support": "workspace:*",
    "payload-ai-channels": "workspace:*",
    "payload-ai-insights": "workspace:*",
    "payload-ai-media": "workspace:*",
    "payload-ai-copilot": "workspace:*"
  },
  "devDependencies": {
    "payload": "3.92.1"
  },
  "peerDependencies": {
    "payload": "^3.92.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahabub123/payload-ai-suite.git",
    "directory": "packages/ai-suite"
  }
}
