{
  "name": "@payload-ai-suite/ai-search",
  "version": "0.1.0",
  "description": "Smart Search & Recommendations",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
