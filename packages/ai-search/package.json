    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "payload": "3.92.1",
    "zod": "^4.1.0",
    "@payload-ai-suite/ai-core": "workspace:*"
